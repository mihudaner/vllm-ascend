# 此模板由 configure_file 填入 @变量@，生成安装/CPack 阶段执行的 CMake 脚本。
# 不是算子运行时操作，也不在用户安装后再修改 OPP。
# CANN 会把二进制编译所用的绝对 -I 路径写进生成的 Python，需要在发布前去掉。
set(entry "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}/@hcpre_impl@/dynamic/hc_pre_pto.py")
file(READ "${entry}" content)
# 包内 ISA 已安装到 ascendc/common；CANN 入口原本就会根据 PYF_PATH 添加此相对路径。
# 这里只删除构建机路径。若 CANN 生成格式变化则显式报错，避免静默发布错误包。
set(build_include "'-I@HCPRE_ISA_ROOT@/include', ")
string(FIND "${content}" "${build_include}" found)
if(found LESS 0)
  message(FATAL_ERROR "Unexpected generated compiler entry: ${entry}")
endif()
string(REPLACE "${build_include}" "" content "${content}")
file(WRITE "${entry}" "${content}")
